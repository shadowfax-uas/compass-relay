# systemd EnvironmentFile: literal KEY=value assignments; no "export" or commands.
# This is Elijah's dedicated bench stream, previously used successfully in Compass.
# Use a separate, agreed stream name for each concurrent publisher / real camera.
COMPASS_URL="rtsp://compass.mchmr.us:554/elijah-pi-sim-test/group/AFCENT"

# The camera/simulator must send H.264 inside MPEG-TS to this UDP port on the Pi.
UDP_PORT=15004
